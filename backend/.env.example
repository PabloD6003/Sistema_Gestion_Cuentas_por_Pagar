APP_ENV=local
APP_DEBUG=1
APP_URL=http://localhost:8000

SESSION_NAME=cxp_session

DB_DRIVER=odbc
DB_HOST=.\SQLEXPRESS
DB_PORT=
DB_NAME=CuentasPorPagarDB
DB_TRUSTED=1
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=1
DB_TRUST_SERVER_CERTIFICATE=1
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

DW_NAME=CuentasPorPagarDW

BACKUP_PATH=

# Consulta pública de contribuyentes de Hacienda (formulario de proveedores)
HACIENDA_API_URL=https://api.hacienda.go.cr/fe/ae
HACIENDA_TIMEOUT=5
# Archivo de certificados raíz (.pem). Vacío: en Windows se usa el almacén del sistema.
HACIENDA_CA_BUNDLE=
